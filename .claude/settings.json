{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONPATH": "."
  },
  "attribution": {
    "commit": "🤖 Merged CLAUDE generated by local consolidation",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(git diff *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(python *)",
      "Bash(pip install *)",
      "Bash(conda *)",
      "Bash(cmake *)",
      "Bash(make *)",
      "Bash(docker *)",
      "Bash(onnx*)",
      "Bash(trtexec *)",
      "Bash(voyager *)",
      "Bash(mo *)",
      "Bash(hailo *)",
      "Bash(nvidia-smi)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/credentials*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(DROP TABLE *)",
      "Bash(shutdown *)",
      "Bash(format *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'File modified'",
            "shell": "bash"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "autoMemoryEnabled": true,
  "theme": "auto",
  "defaultMode": "acceptEdits",
  "alwaysThinkingEnabled": false
}
