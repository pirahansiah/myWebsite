{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONPATH": ".",
    "CONDA_DEFAULT_ENV": "py314"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git diff *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git clone *)",
      "Bash(git remote *)",
      "Bash(python *)",
      "Bash(pip install *)",
      "Bash(pip list *)",
      "Bash(conda *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(docker *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(cmake *)",
      "Bash(make *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/credentials*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git config *)",
      "Bash(gpg *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(git push origin main *)",
      "Bash(git push origin master *)",
      "Bash(git reset *)",
      "Bash(rm -rf *)",
      "Bash(git branch -D *)"
    ]
  },
  "effortLevel": "high",
  "autoMemoryEnabled": true,
  "theme": "auto",
  "defaultMode": "acceptEdits"
}
