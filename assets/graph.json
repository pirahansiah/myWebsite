---
layout: none
---
{%- comment %}
  Auto-generated graph.json from Jekyll page frontmatter.
  Hub nodes are hardcoded. Page nodes and edges are generated from site.pages.
  Edges: hub→category (1.0), same-directory (0.5), shared-tags (0.3).
{%- endcomment %}
{
  "nodes": [
    {"id": "hub-product", "label": "Product", "url": "/contents/public/product/", "category": "hub", "size": 5},
    {"id": "hub-research", "label": "Research", "url": "/contents/public/research/", "category": "hub", "size": 5},
    {"id": "hub-solutions", "label": "Solutions", "url": "/contents/public/solutions/", "category": "hub", "size": 5},
    {"id": "hub-content", "label": "Content Hub", "url": "/contents/public/", "category": "hub", "size": 5},
    {"id": "hub-wiki", "label": "Wiki", "url": "/contents/wiki/", "category": "hub", "size": 4},
    {"id": "hub-portfolio", "label": "Portfolio", "url": "/contents/pkm/use-cases/", "category": "hub", "size": 4}
{%- assign hub_urls = "/contents/public/product/,/contents/public/research/,/contents/public/solutions/,/contents/public/,/contents/wiki/,/contents/pkm/use-cases/" | split: "," %}
{%- for page in site.pages -%}
  {%- if page.title and page.url contains '/contents/' -%}
    {%- unless hub_urls contains page.url -%}
      {%- assign cat = 'hub' -%}
      {%- if page.url contains '/publications/Papers/' -%}{%- assign cat = 'paper' -%}
      {%- elsif page.url contains '/publications/Journals/' -%}{%- assign cat = 'journal' -%}
      {%- elsif page.url contains '/publications/Books/' -%}{%- assign cat = 'book' -%}
      {%- elsif page.url contains '/publications/Patents/' -%}{%- assign cat = 'patent' -%}
      {%- elsif page.url contains '/publications/Keynotes/' -%}{%- assign cat = 'keynote' -%}
      {%- elsif page.url contains '/ai2026/' -%}{%- assign cat = 'course' -%}
      {%- elsif page.url contains '/public/cv/' -%}{%- assign cat = 'cv' -%}
      {%- elsif page.url contains '/public/ai-llm/' -%}{%- assign cat = 'ai' -%}
      {%- elsif page.url contains '/public/cuda-gpu/' -%}{%- assign cat = 'cuda' -%}
      {%- elsif page.url contains '/pkm/' -%}{%- assign cat = 'pkm' -%}
      {%- elsif page.url contains '/public/' -%}{%- assign cat = 'business' -%}
      {%- endif -%}
      {%- assign slug_parts = page.url | replace: '/contents/', '' | split: '/' -%}
      {%- assign slug = '' -%}
      {%- for part in slug_parts -%}
        {%- if part != '' -%}
          {%- if slug != '' -%}{%- assign slug = slug | append: '-' -%}{%- endif -%}
          {%- assign slug = slug | append: part -%}
        {%- endif -%}
      {%- endfor -%}
,    {"id": {{ slug | jsonify }}, "label": {{ page.title | jsonify }}, "url": {{ page.url | jsonify }}, "category": {{ cat | jsonify }}, "size": 3}
    {%- endunless -%}
  {%- endif -%}
{%- endfor %}
  ],
  "edges": [
    {"source": "hub-content", "target": "hub-product", "strength": 1.0},
    {"source": "hub-content", "target": "hub-research", "strength": 1.0},
    {"source": "hub-content", "target": "hub-solutions", "strength": 1.0},
    {"source": "hub-content", "target": "hub-portfolio", "strength": 1.0},
    {"source": "hub-content", "target": "hub-wiki", "strength": 0.8},
    {"source": "hub-portfolio", "target": "hub-content", "strength": 0.8}
{%- for page in site.pages -%}
  {%- if page.title and page.url contains '/contents/' -%}
    {%- unless hub_urls contains page.url -%}
      {%- assign cat = 'hub' -%}
      {%- if page.url contains '/publications/Papers/' -%}{%- assign cat = 'paper' -%}
      {%- elsif page.url contains '/publications/Journals/' -%}{%- assign cat = 'journal' -%}
      {%- elsif page.url contains '/publications/Books/' -%}{%- assign cat = 'book' -%}
      {%- elsif page.url contains '/publications/Patents/' -%}{%- assign cat = 'patent' -%}
      {%- elsif page.url contains '/publications/Keynotes/' -%}{%- assign cat = 'keynote' -%}
      {%- elsif page.url contains '/ai2026/' -%}{%- assign cat = 'course' -%}
      {%- elsif page.url contains '/public/cv/' -%}{%- assign cat = 'cv' -%}
      {%- elsif page.url contains '/public/ai-llm/' -%}{%- assign cat = 'ai' -%}
      {%- elsif page.url contains '/public/cuda-gpu/' -%}{%- assign cat = 'cuda' -%}
      {%- elsif page.url contains '/pkm/' -%}{%- assign cat = 'pkm' -%}
      {%- elsif page.url contains '/public/' -%}{%- assign cat = 'business' -%}
      {%- endif -%}
      {%- assign slug_parts = page.url | replace: '/contents/', '' | split: '/' -%}
      {%- assign slug = '' -%}
      {%- for part in slug_parts -%}
        {%- if part != '' -%}
          {%- if slug != '' -%}{%- assign slug = slug | append: '-' -%}{%- endif -%}
          {%- assign slug = slug | append: part -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign hub_id = '' -%}
      {%- if cat == 'cv' or cat == 'ai' or cat == 'cuda' -%}{%- assign hub_id = 'hub-product' -%}
      {%- elsif cat == 'paper' or cat == 'journal' or cat == 'book' or cat == 'patent' or cat == 'keynote' -%}{%- assign hub_id = 'hub-research' -%}
      {%- elsif cat == 'course' -%}{%- assign hub_id = 'hub-solutions' -%}
      {%- elsif cat == 'pkm' -%}{%- assign hub_id = 'hub-portfolio' -%}
      {%- endif -%}
      {%- if hub_id != '' %}
,    {"source": {{ hub_id | jsonify }}, "target": {{ slug | jsonify }}, "strength": 1.0}
      {%- endif %}
,    {"source": "hub-content", "target": {{ slug | jsonify }}, "strength": 0.8}
,    {"source": "hub-wiki", "target": {{ slug | jsonify }}, "strength": 0.8}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- for page1 in site.pages -%}
  {%- if page1.title and page1.url contains '/contents/' -%}
    {%- unless hub_urls contains page1.url -%}
      {%- assign slug1_parts = page1.url | replace: '/contents/', '' | split: '/' -%}
      {%- assign slug1 = '' -%}
      {%- for part in slug1_parts -%}
        {%- if part != '' -%}
          {%- if slug1 != '' -%}{%- assign slug1 = slug1 | append: '-' -%}{%- endif -%}
          {%- assign slug1 = slug1 | append: part -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign p1_parts = page1.url | split: '/' -%}
      {%- assign p1_total = p1_parts.size -%}
      {%- assign dir1 = '' -%}
      {%- for part in p1_parts -%}
        {%- if forloop.index <= p1_total | minus: 2 -%}
          {%- if dir1 != '' -%}{%- assign dir1 = dir1 | append: '/' -%}{%- endif -%}
          {%- assign dir1 = dir1 | append: part -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign dir1 = dir1 | append: '/' -%}
      {%- for page2 in site.pages -%}
        {%- if page2.title and page2.url contains '/contents/' -%}
          {%- unless hub_urls contains page2.url -%}
            {%- if page1.url < page2.url -%}
              {%- assign slug2_parts = page2.url | replace: '/contents/', '' | split: '/' -%}
              {%- assign slug2 = '' -%}
              {%- for part in slug2_parts -%}
                {%- if part != '' -%}
                  {%- if slug2 != '' -%}{%- assign slug2 = slug2 | append: '-' -%}{%- endif -%}
                  {%- assign slug2 = slug2 | append: part -%}
                {%- endif -%}
              {%- endfor -%}
              {%- assign p2_parts = page2.url | split: '/' -%}
              {%- assign p2_total = p2_parts.size -%}
              {%- assign dir2 = '' -%}
              {%- for part in p2_parts -%}
                {%- if forloop.index <= p2_total | minus: 2 -%}
                  {%- if dir2 != '' -%}{%- assign dir2 = dir2 | append: '/' -%}{%- endif -%}
                  {%- assign dir2 = dir2 | append: part -%}
                {%- endif -%}
              {%- endfor -%}
              {%- assign dir2 = dir2 | append: '/' -%}
              {%- if dir1 == dir2 %}
,    {"source": {{ slug1 | jsonify }}, "target": {{ slug2 | jsonify }}, "strength": 0.5}
              {%- elsif page1.tags and page2.tags -%}
                {%- assign tag_matched = false -%}
                {%- for tag in page1.tags -%}
                  {%- if page2.tags contains tag and tag_matched == false -%}
                    {%- assign tag_matched = true %}
,    {"source": {{ slug1 | jsonify }}, "target": {{ slug2 | jsonify }}, "strength": 0.3}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor %}
  ]
}
